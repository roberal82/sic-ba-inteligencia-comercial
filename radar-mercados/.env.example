# Copiar como backend/.env (o exportar estas variables) antes de ejecutar la aplicacion.
# Ninguna clave real debe commitearse al repositorio.

# demo: usa siempre datos de respaldo marcados como tales, ideal para desarrollo y demos.
# production: intenta fuentes en vivo y cae a respaldo automaticamente si una fuente falla.
APP_MODE=demo

# Base de datos. SQLite por defecto (facil para desarrollo local). En Docker se usa PostgreSQL.
DATABASE_URL=sqlite:///./radar_mercados.db
# DATABASE_URL=postgresql+psycopg2://radar:CAMBIAR@localhost:5432/radar_mercados

# Cache opcional. Si se deja vacio, se usa cache en memoria del proceso.
REDIS_URL=

# CORS: lista separada por comas, o "*" para permitir cualquier origen (solo recomendado en demo).
CORS_ORIGINS=*

# Token requerido para POST /api/admin/refresh. Si se deja vacio, ese endpoint queda deshabilitado.
ADMIN_TOKEN=

# Claves de proveedores externos (opcionales). Sin clave, esos servicios documentan la limitacion
# en /api/sources y sirven datos demostrativos en su lugar.
ALPHA_VANTAGE_API_KEY=
TWELVE_DATA_API_KEY=
POLYGON_API_KEY=
NEWS_API_KEY=
FRED_API_KEY=

# Timeouts y reintentos para llamadas a fuentes externas.
HTTP_TIMEOUT_SECONDS=8
HTTP_MAX_RETRIES=2
CACHE_TTL_SECONDS=300

# Frecuencia de tareas programadas (minutos).
REFRESH_MINUTES_MARKETS=15
REFRESH_MINUTES_MACRO=1440
REFRESH_MINUTES_NEWS=15
REFRESH_MINUTES_EVENTS=15

# Limite de peticiones por minuto por IP.
RATE_LIMIT_PER_MINUTE=120

# Activar/desactivar el scheduler embebido (APScheduler).
ENABLE_SCHEDULER=true

# Variables para docker-compose (infra/docker-compose.yml)
POSTGRES_DB=radar_mercados
POSTGRES_USER=radar
POSTGRES_PASSWORD=CAMBIAR_ESTA_CLAVE
